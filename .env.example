# Copy to .env.local (local) and add the same variables in Vercel → Settings → Environment Variables.

# Supabase project "MMC Techniek B.V" (ref stjmmlzykokwaqkushnu)
NEXT_PUBLIC_SUPABASE_URL=https://stjmmlzykokwaqkushnu.supabase.co
# Publishable key (safe in the browser). Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (server only, never prefix with NEXT_PUBLIC_). Same page, "Secret keys".
# Used for: inserting quote requests, inviting admin users, scripts/seed-media.mjs.
SUPABASE_SECRET_KEY=sb_secret_...

# Public site URL, used for canonical links, sitemap, OG images and email links.
NEXT_PUBLIC_SITE_URL=https://www.mmctechniek.nl

# Random string used to hash visitor IPs for rate limiting (no raw IPs are stored).
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# Email for new quote requests: "resend", "smtp" or "log" (log = print to the server console, for development).
MAIL_PROVIDER=log
MAIL_FROM="MMC Techniek <info@mmctechniek.nl>"
MAIL_TO=info@mmctechniek.nl
# When MAIL_PROVIDER=resend
RESEND_API_KEY=
# When MAIL_PROVIDER=smtp (for example the existing info@mmctechniek.nl mailbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
